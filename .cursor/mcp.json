{
  "mcpServers": {
    "serena": {
      "command": "/home/bogdan/.local/bin/serena",
      "args": [
        "start-mcp-server",
        "--project=/home/bogdan/projects/pointman",
        "--context=ide"
      ]
    },
    "kwin-mcp": {
      "command": "/home/bogdan/.local/bin/kwin-mcp",
      "args": ["--default-live-session"],
      "env": {
        "WAYLAND_DISPLAY": "wayland-0",
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/user/1000/bus"
      }
    },
    "ghidra": {
      "command": "/home/bogdan/.local/bin/uv",
      "args": [
        "run",
        "--directory",
        "/home/bogdan/src/ghidra-mcp",
        "bridge-mcp-ghidra"
      ],
      "env": {
        "JAVA_HOME": "/home/bogdan/src/jdk-21",
        "PATH": "/home/bogdan/src/jdk-21/bin:/usr/bin:/usr/sbin"
      }
    }
  }
}
